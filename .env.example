# ExitLab Server Environment Variables
# Copy to .env and provide your API keys. NEVER commit .env to version control!

# Server port for backend / proxy
PORT=3001

# Meta / Llama API Key (e.g. from Meta AI partner endpoint, Llama API, Groq, or Together AI supporting Llama 3.x models)
META_LLAMA_API_KEY=
META_LLAMA_BASE_URL=https://api.groq.com/openai/v1
META_LLAMA_MODEL=llama-3.3-70b-versatile
